NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_hr?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_PREFIX=aihr
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000
SLACK_SIGNING_SECRET=replace_with_slack_signing_secret
SLACK_SIGNATURE_MAX_AGE_SECONDS=300
SLACK_BOT_TOKEN=replace_with_slack_bot_token
SLACK_API_BASE_URL=https://slack.com/api
GOOGLE_SHEETS_API_KEY=replace_with_google_sheets_api_key
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_spreadsheet_id
GOOGLE_SHEETS_RANGE=Preferences!A:B
GOOGLE_SHEETS_CACHE_TTL_SECONDS=300
PREFERENCE_SYNC_CRON=0 9 * * *
PREFERENCE_SYNC_TIMEZONE=UTC
MICROSOFT_TENANT_ID=replace_with_tenant_id
MICROSOFT_CLIENT_ID=replace_with_client_id
MICROSOFT_CLIENT_SECRET=replace_with_client_secret
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace_with_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT=replace_with_deployment_name
AZURE_OPENAI_API_VERSION=2024-10-21
