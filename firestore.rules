rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(ownerId) {
      return request.auth.uid == ownerId;
    }
    
    // Helper function to validate document data
    function isValidDocument() {
      let requiredFields = ['ownerId', 'fileName', 'mimeType', 'fileSize', 'ipfsCID', 'ipfsURL'];
      let hasAllFields = request.resource.data.keys().hasAll(requiredFields);
      let hasValidOwner = request.resource.data.ownerId == request.auth.uid;
      let hasValidFileName = request.resource.data.fileName is string && request.resource.data.fileName.size() > 0;
      let hasValidFileSize = request.resource.data.fileSize is number && request.resource.data.fileSize > 0;
      
      return hasAllFields && hasValidOwner && hasValidFileName && hasValidFileSize;
    }
    
    // Documents collection rules
    match /documents/{documentId} {
      // Allow read only if authenticated and user owns the document
      allow read: if isAuthenticated() && isOwner(resource.data.ownerId);
      
      // Allow create only if authenticated and data is valid
      allow create: if isAuthenticated() && isValidDocument();
      
      // Allow update only if authenticated, user owns the document, and cannot change ownerId
      allow update: if isAuthenticated() 
        && isOwner(resource.data.ownerId) 
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ipfsCID == resource.data.ipfsCID;
      
      // Allow delete only if authenticated and user owns the document
      allow delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }
    
    // Users collection rules
    match /users/{userId} {
      // Allow users to read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow users to create/update their own profile
      allow create, update: if isAuthenticated() 
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      
      // Users cannot delete their profile (admin only)
      allow delete: if false;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
